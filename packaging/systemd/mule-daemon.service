[Unit]
Description=eMule-Rust Headless P2P Daemon
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/laurentgeynet-ux/eMule-Rust

[Service]
Type=simple
User=caraveliko
Group=caraveliko
WorkingDirectory=/home/caraveliko/.emulerust
ExecStart=/usr/local/bin/mule-daemon --workdir /home/caraveliko/.emulerust --downloads-dir /home/caraveliko/amule/incoming --bind 0.0.0.0:4660 --web-dir /usr/local/share/mule-rust/web
Restart=always
RestartSec=5

# Resource & Network Sandboxing
LimitNOFILE=65535
MemoryHigh=250M
MemoryMax=500M
Nice=-5

# Security hardening
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/caraveliko/.emulerust /home/caraveliko/amule
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
